#!/usr/bin/env bash
# Pre-commit hook: auto-format with gofmt and lint with golangci-lint.
# Installed via: git config core.hooksPath .githooks
# See also: make install (sets hooksPath automatically)

set -euo pipefail

# Only check staged Go files (Added, Copied, Modified). No early exit here:
# the issuegraph section at the bottom must run for non-Go commits too.
staged_go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
if [ -n "$staged_go_files" ]; then
    # Build golangci-lint from source so it is never a stale global binary, and
    # pin the version to the one CI uses (.github/workflows/{pr,main}.yml).
    GOLANGCI_LINT="go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.10.1"

    # Build it with the repo's own Go, the way CI does. In CI, actions/setup-go
    # installs the go.mod version and exports GOTOOLCHAIN=local. Locally
    # GOTOOLCHAIN defaults to "auto", and for a pkg@version build that honours
    # golangci-lint's own toolchain directive instead: it downgrades to
    # go1.25.12, which then refuses this repo's newer go directive at config
    # load ("the Go language version (go1.25) used to build golangci-lint is
    # lower than the targeted Go version") and fails every Go commit. Pinning to
    # the go directive reproduces CI's resolution on any host toolchain.
    go_toolchain="go$(awk '$1 == "go" { print $2; exit }' go.mod)"
    if [ "$go_toolchain" = "go" ]; then
        echo >&2 "pre-commit: no go directive in go.mod; cannot pin the lint toolchain"
        exit 1
    fi

    # Auto-format and re-stage
    echo "$staged_go_files" | xargs gofmt -w
    echo "$staged_go_files" | xargs git add

    # Lint changed code with auto-fix; block on remaining issues.
    # CGO_ENABLED=0 avoids typecheck failures from CGO-only dependencies
    # (e.g., dolthub/go-icu-regex) that require system headers not always present.
    CGO_ENABLED=0 GOTOOLCHAIN="$go_toolchain" $GOLANGCI_LINT run --new-from-rev=HEAD --fix || exit 1

    # Re-stage any auto-fixes from the linter
    echo "$staged_go_files" | xargs git add
fi

# --- BEGIN ISSUEGRAPH INTEGRATION v1.3.0 ---
# This section is managed by issuegraph. Do not remove these markers.
if command -v issuegraph >/dev/null 2>&1; then
  export ISSUEGRAPH_GIT_HOOK=1
  _issuegraph_timeout=${ISSUEGRAPH_HOOK_TIMEOUT:-300}
  case "$_issuegraph_timeout" in
    *[!0-9]*|'') _issuegraph_timeout_invalid=1 ;;
    *[1-9]*) _issuegraph_timeout_invalid=0 ;;
    *) _issuegraph_timeout_invalid=1 ;;
  esac
  if [ "$_issuegraph_timeout_invalid" -eq 1 ]; then
    echo >&2 "issuegraph: invalid ISSUEGRAPH_HOOK_TIMEOUT; using 300 seconds"
    _issuegraph_timeout=300
  fi
  _issuegraph_timeout_backend=none
  _issuegraph_timeout_command=
  for _issuegraph_timeout_candidate in timeout gtimeout; do
    if command -v "$_issuegraph_timeout_candidate" >/dev/null 2>&1; then
      if _issuegraph_timeout_version="$("$_issuegraph_timeout_candidate" --version 2>/dev/null)"; then
        case "$_issuegraph_timeout_version" in
          "timeout (GNU coreutils) "*) _issuegraph_timeout_command=$_issuegraph_timeout_candidate; break ;;
        esac
      fi
    fi
  done
  if [ -n "$_issuegraph_timeout_command" ]; then
    _issuegraph_timeout_backend=coreutils
    if "$_issuegraph_timeout_command" -- "$_issuegraph_timeout" issuegraph hooks run pre-commit "$@"; then
      _issuegraph_exit=0
    else
      _issuegraph_exit=$?
    fi
  elif command -v perl >/dev/null 2>&1; then
    _issuegraph_timeout_backend=perl
    if perl -e 'alarm shift; exec @ARGV' -- "$_issuegraph_timeout" issuegraph hooks run pre-commit "$@"; then
      _issuegraph_exit=0
    else
      _issuegraph_exit=$?
    fi
  else
    echo >&2 "issuegraph: hook 'pre-commit' running without timeout; install coreutils or perl to enable ISSUEGRAPH_HOOK_TIMEOUT"
    if issuegraph hooks run pre-commit "$@"; then
      _issuegraph_exit=0
    else
      _issuegraph_exit=$?
    fi
  fi
  if { [ "$_issuegraph_timeout_backend" = coreutils ] && [ "$_issuegraph_exit" -eq 124 ]; } || { [ "$_issuegraph_timeout_backend" = perl ] && [ "$_issuegraph_exit" -eq 142 ]; }; then
    echo >&2 "issuegraph: hook 'pre-commit' timed out after ${_issuegraph_timeout}s — continuing without issuegraph"
    _issuegraph_exit=0
  fi
  if [ "$_issuegraph_exit" -eq 3 ]; then
    echo >&2 "issuegraph: database not initialized — skipping hook 'pre-commit'"
    _issuegraph_exit=0
  fi
  if [ "$_issuegraph_exit" -ne 0 ]; then exit "$_issuegraph_exit"; fi
fi
# --- END ISSUEGRAPH INTEGRATION v1.3.0 ---
