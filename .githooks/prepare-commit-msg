if command -v issuegraph >/dev/null 2>&1; then
  export ISSUEGRAPH_GIT_HOOK=1
  _issuegraph_timeout=${ISSUEGRAPH_HOOK_TIMEOUT:-300}
  case "$_issuegraph_timeout" in
    *[!0-9]*|'') _issuegraph_timeout_invalid=1 ;;
    *[1-9]*) _issuegraph_timeout_invalid=0 ;;
    *) _issuegraph_timeout_invalid=1 ;;
  esac
  if [ "$_issuegraph_timeout_invalid" -eq 1 ]; then
    echo >&2 "issuegraph: invalid ISSUEGRAPH_HOOK_TIMEOUT; using 300 seconds"
    _issuegraph_timeout=300
  fi
  _issuegraph_timeout_backend=none
  _issuegraph_timeout_command=
  for _issuegraph_timeout_candidate in timeout gtimeout; do
    if command -v "$_issuegraph_timeout_candidate" >/dev/null 2>&1; then
      if _issuegraph_timeout_version="$("$_issuegraph_timeout_candidate" --version 2>/dev/null)"; then
        case "$_issuegraph_timeout_version" in
          "timeout (GNU coreutils) "*) _issuegraph_timeout_command=$_issuegraph_timeout_candidate; break ;;
        esac
      fi
    fi
  done
  if [ -n "$_issuegraph_timeout_command" ]; then
    _issuegraph_timeout_backend=coreutils
    if "$_issuegraph_timeout_command" -- "$_issuegraph_timeout" issuegraph hooks run prepare-commit-msg "$@"; then
      _issuegraph_exit=0
    else
      _issuegraph_exit=$?
    fi
  elif command -v perl >/dev/null 2>&1; then
    _issuegraph_timeout_backend=perl
    if perl -e 'alarm shift; exec @ARGV' -- "$_issuegraph_timeout" issuegraph hooks run prepare-commit-msg "$@"; then
      _issuegraph_exit=0
    else
      _issuegraph_exit=$?
    fi
  else
    echo >&2 "issuegraph: hook 'prepare-commit-msg' running without timeout; install coreutils or perl to enable ISSUEGRAPH_HOOK_TIMEOUT"
    if issuegraph hooks run prepare-commit-msg "$@"; then
      _issuegraph_exit=0
    else
      _issuegraph_exit=$?
    fi
  fi
  if { [ "$_issuegraph_timeout_backend" = coreutils ] && [ "$_issuegraph_exit" -eq 124 ]; } || { [ "$_issuegraph_timeout_backend" = perl ] && [ "$_issuegraph_exit" -eq 142 ]; }; then
    echo >&2 "issuegraph: hook 'prepare-commit-msg' timed out after ${_issuegraph_timeout}s — continuing without issuegraph"
    _issuegraph_exit=0
  fi
  if [ "$_issuegraph_exit" -eq 3 ]; then
    echo >&2 "issuegraph: database not initialized — skipping hook 'prepare-commit-msg'"
    _issuegraph_exit=0
  fi
  if [ "$_issuegraph_exit" -ne 0 ]; then exit "$_issuegraph_exit"; fi
