{
  "name": "issuegraph",
  "description": "AI-supervised issue tracker for coding workflows. Manage tasks, discover work, and maintain context with simple CLI commands.",
  "version": "1.3.0",
  "author": {
    "name": "Steve Yegge",
    "url": "https://github.com/steveyegge"
  },
  "repository": "https://github.com/borg0ai/dx-issuegraph",
  "license": "MIT",
  "homepage": "https://github.com/borg0ai/dx-issuegraph",
  "keywords": [
    "issue-tracker",
    "task-management",
    "ai-workflow",
    "agent-memory"
  ],
  "skills": "./skills/",
  "commands": "./skills/issuegraph/commands/",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "issuegraph prime"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "issuegraph prime"
          }
        ]
      }
    ]
  }
}
